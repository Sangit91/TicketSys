# TicketSys Backend — biến môi trường (bản .env thật KHÔNG commit; file này là mẫu)

# --- PostgreSQL (docker: host 9432 -> container 5432) ---
POSTGRES_USER=ticketsys
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=ticketsys

# Prisma — kết nối từ API (chạy trên host / hoặc trong container dùng host `db`)
DATABASE_URL=postgresql://ticketsys:change_me_strong@localhost:9432/ticketsys?schema=public

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_32chars_min
JWT_REFRESH_SECRET=change_me_refresh_secret_32chars_min
ACCESS_TOKEN_TTL=900          # 15 phút
REFRESH_TOKEN_TTL=604800      # 7 ngày

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9100
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET_ATTACHMENTS=ticket-attachments
MINIO_BUCKET_E2E=ticket-e2e
MINIO_BUCKET_PROPOSAL=ticket-proposal

# API NestJS
PORT=3001
CORS_ORIGIN=http://localhost:9000

# Frontend
VITE_API_BASE=http://localhost:9001/api